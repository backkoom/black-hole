#!/usr/bin/env bash
# ==============================================================================
# blackhole-api —— systemd unit 模板
#
# 安装：
#   sudo cp deploy/blackhole-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now blackhole-api
#
# ⚠️ 改完 EnvironmentFile 的路径要同步改这里。
# ⚠️ 不要把 DATABASE_URL / 口令直接写进本文件 —— 全部走 /etc/blackhole/api.env，
#    权限设 600，属主 root。
# ==============================================================================

[Unit]
Description=Black Hole API (Fastify)
Documentation=file:///data/blackhole/deploy/README.md
After=network-online.target postgresql.service
Wants=network-online.target
# ⚠️ StartLimit* 属于 [Unit] 段 —— 放 [Service] 会被 systemd 忽略
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=blackhole
Group=blackhole

# 环境变量集中放这一个文件（不进仓库）
EnvironmentFile=/etc/blackhole/api.env

WorkingDirectory=/data/blackhole/apps/api
ExecStart=/usr/bin/node /data/blackhole/apps/api/dist/server.js

# 重启策略：崩了自动拉起，但 5 分钟内最多 3 次（避免疯狂重启刷日志）
Restart=always
RestartSec=5

# 日志走 journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=blackhole-api

# ---- 安全加固 ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# 需要写的位置：node_modules 缓存目录（若用 npm ci 一般不需要写）留给 /tmp
ReadWritePaths=/data/blackhole/logs
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
