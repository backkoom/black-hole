# ==============================================================================
# 工作台与组织架构 —— 生产环境变量模板
#
# 安装：
#   sudo mkdir -p /etc/workbench
#   sudo cp deploy/env.production.example /etc/workbench/api.env
#   sudo chmod 600 /etc/workbench/api.env
#   sudo chown root:root /etc/workbench/api.env
#   sudo vi /etc/workbench/api.env      # 填真实值
#
# ⚠️ 这个文件不进仓库。所有口令、数据库连接串只存在服务器这一份。
# ==============================================================================

# ---- 运行环境 ----
NODE_ENV=production
PORT=3000
TZ=Asia/Shanghai
LOG_LEVEL=info

# ---- 数据库 ----
# 生产库连接串。密码里有特殊字符（@ : / ? #）必须 URL 编码
DATABASE_URL=postgres://workbench:CHANGE_ME@127.0.0.1:5432/workbench

# ---- 站点来源（必须是 https，不能带末尾斜杠）----
# ⚠️ 必须与浏览器地址栏完全一致，否则 Origin 校验会拒绝所有写请求
APP_ORIGIN=https://workbench.example.internal

# ---- Cookie ----
# 生产必须 true（httpOnly + secure）
COOKIE_SECURE=true
SESSION_TTL_DAYS=7

# ---- 业务参数 ----
MAX_ORG_LEVEL=32
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=10000

# ---- 种子账号口令（仅首次播种时用；播种后建议从本文件删掉这两行）----
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_USER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
