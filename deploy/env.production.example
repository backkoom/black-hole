# ==============================================================================
# 工作台与组织架构 —— 生产环境变量模板
#
# 安装：
#   sudo mkdir -p /etc/blackhole
#   sudo cp deploy/env.production.example /etc/blackhole/api.env
#   sudo chmod 600 /etc/blackhole/api.env
#   sudo chown root:root /etc/blackhole/api.env
#   sudo vi /etc/blackhole/api.env      # 填真实值
#
# ⚠️ 这个文件不进仓库。所有口令、数据库连接串只存在服务器这一份。
# ==============================================================================

# ---- 运行环境 ----
NODE_ENV=production
PORT=3000
TZ=Asia/Shanghai
LOG_LEVEL=info

# ---- 数据库 ----
# 生产库连接串。密码里有特殊字符（@ : / ? #）必须 URL 编码
DATABASE_URL=postgres://blackhole:CHANGE_ME@127.0.0.1:5432/blackhole

# ---- 站点来源（必须是 https，不能带末尾斜杠）----
# ⚠️ 必须与浏览器地址栏完全一致，否则 Origin 校验会拒绝所有写请求
APP_ORIGIN=https://blackhole.example.internal

# ---- Cookie ----
# 生产必须 true（httpOnly + secure）
COOKIE_SECURE=true
SESSION_TTL_DAYS=7

# ---- 业务参数 ----
MAX_ORG_LEVEL=32
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=10000

# ---- 种子账号口令（仅首次播种时用；播种后建议从本文件删掉这两行）----
# ---- 种子口令（可选）----
# 只写 admin 一个即可；普通用户的口令由种子脚本随机生成（每次不同）。
# 不写这两行 → 播种时随机生成并打印在终端里。
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- 备份（systemd timer 用；改完 systemctl restart blackhole-backup.timer 或等下次触发）----
# 备份落到哪：本地目录，或已挂载的 NAS 路径（务必先 mount 好，否则会写到本地盘）
BACKUP_DIR=/data/backups/blackhole
# 保留多少份（按时间戳目录，超出删最旧的）
BACKUP_KEEP=14
# 是否允许定时备份；false 时脚本直接退出 0（适合"这个环境不归我备份"的场合）
BACKUP_ENABLED=true
