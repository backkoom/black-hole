# ==============================================================================
# 工作台与组织架构 —— 内网验收（staging）环境变量模板
#
# 与生产的区别：
#   - NODE_ENV=staging，允许 http，COOKIE_SECURE 可以是 false
#   - ⚠️ 会话 Cookie 明文传输 —— **仅限内网验收，不能承载真实业务数据**
#
# 安装：
#   sudo cp deploy/env.staging.example /etc/blackhole/api.env
#   sudo chmod 600 /etc/blackhole/api.env
# ==============================================================================

NODE_ENV=staging
PORT=3000
TZ=Asia/Shanghai
LOG_LEVEL=info

DATABASE_URL=postgres://blackhole:CHANGE_ME@127.0.0.1:5432/blackhole

# 内网地址，http 或 https 都行；必须与浏览器地址栏完全一致（不带末尾斜杠）
APP_ORIGIN=http://blackhole.example.internal

COOKIE_SECURE=false
SESSION_TTL_DAYS=7

MAX_ORG_LEVEL=32
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=10000
# 种子口令（可选）：不写则由种子脚本随机生成并打印
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- 备份（systemd timer 用；改完 systemctl restart blackhole-backup.timer 或等下次触发）----
# 备份落到哪：本地目录，或已挂载的 NAS 路径（务必先 mount 好，否则会写到本地盘）
BACKUP_DIR=/data/backups/blackhole
# 保留多少份（按时间戳目录，超出删最旧的）
BACKUP_KEEP=14
# 是否允许定时备份；false 时脚本直接退出 0（适合"这个环境不归我备份"的场合）
BACKUP_ENABLED=true

# ---- 文件上传（用户端「文件资料」）----
# 上传的实体放哪。必须是应用可写、容量够的盘；备份脚本会把整个目录打进备份包。
# 相对路径按安装目录解析，生产建议给绝对路径。
FILE_STORAGE_DIR=/data/blackhole/storage/files
# 单个文件上限（MB），超过直接 413，不落盘
MAX_UPLOAD_MB=50
