[Unit]
Description=工作台备份（数据库 + 前端产物 + 环境变量）
Documentation=file:///data/blackhole/deploy/README.md
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
# 从服务环境变量里读 BACKUP_DIR / BACKUP_KEEP / BACKUP_ENABLED（前缀 - 表示文件不存在也不报错）
EnvironmentFile=-/etc/blackhole/api.env
# 备份脚本自带保留策略（KEEP），失败会返回非 0 → systemctl --failed 能看到
ExecStart=/bin/bash /data/blackhole/deploy/backup.sh
# 别和业务抢 IO
Nice=10
IOSchedulingClass=idle
# 备份目录/保留份数/开关优先取 api.env 里的 BACKUP_DIR / BACKUP_KEEP / BACKUP_ENABLED，
# 这里不要再写 Environment=，否则会盖掉配置文件里的值。
