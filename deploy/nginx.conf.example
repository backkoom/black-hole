# ==============================================================================
# 形态 A：项目自带 nginx（这个 server 独占 80/443）—— 完整配置文件
#
# 用法：
#   sudo cp deploy/nginx.conf.example /etc/nginx/conf.d/blackhole.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# 如果服务器上**已经跑着别的站点**，别用这个文件，改用
#   deploy/nginx-integrate.conf.snippet（只贴 location 片段）
#
# ⚠️ 下文的域名、端口、证书路径要按实际环境改。
# ⚠️ 没有证书时：把「80 跳转」那段和 443 那段先注释掉，只留一个 80 的 server
#    （可以直接照抄本机现状：listen 80 default_server; server_name _; + 同样三个 location）。
#    HTTP 下 NODE_ENV 必须是 staging（production 强制要求 https，会启动失败）。
# ==============================================================================

# ---------------------------------------------------------------------------
# HTTP → HTTPS 跳转
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name blackhole.example.internal;

    # certbot 续期用；没有证书就把下面两行留空
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# 主站
# ---------------------------------------------------------------------------
server {
    # ⚠️ 写成 `listen 443 ssl http2;` 而不是 `listen 443 ssl;` + `http2 on;`：
    #    后者要 nginx ≥ 1.25.1，Ubuntu 24.04 仓库里是 1.24，会直接报 unknown directive。
    #    1.25+ 上这种写法只会有一条 deprecated 警告，不影响运行。
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name blackhole.example.internal;

    # --- 证书 ---
    ssl_certificate     /etc/nginx/ssl/blackhole.crt;
    ssl_certificate_key /etc/nginx/ssl/blackhole.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # --- 安全响应头 ---
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "same-origin" always;

    # 上传限制（账号批量导入单文件 2MB，这里留宽一点）
    client_max_body_size 4m;

    # --- 压缩 ---
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript
               application/x-javascript text/xml application/xml image/svg+xml;

    # --- 静态资源（带 hash，可以长缓存）---
    root /data/blackhole/apps/web/dist;
    index index.html;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "same-origin" always;
        try_files $uri =404;
    }

    # --- API 反代到本机 Fastify（保持同源，前端不需要 CORS）---
    location /api/ {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # --- SPA 回退：前端是 history 路由，任何未命中静态文件的路径都交给 index.html ---
    location / {
        try_files $uri $uri/ /index.html;
        # index.html 不缓存，否则前端发版后用户拿到旧壳
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "same-origin" always;
    }

    # --- 源码映射文件不对外（生产不该暴露）---
    location ~* \.map$ {
        deny all;
    }
}
