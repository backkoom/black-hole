# 本地开发环境变量模板。只放占位值，不放真实口令。
# 生产/验收不使用 .env，直接用进程环境变量。

NODE_ENV=development
PORT=3000

# 本机开发实例（Windows 原生 PostgreSQL 18，端口 15432，与老6 已装的 5432/5433 实例隔离）
DATABASE_URL=postgres://workbench:workbench_dev_only@127.0.0.1:15432/workbench_dev

TZ=Asia/Shanghai
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SESSION_TTL_DAYS=7

# 种子初始口令。不设置则种子时随机生成 12 位并只打印一次。
SEED_ADMIN_PASSWORD=ChangeMe-Local-2026
SEED_USER_PASSWORD=ChangeMe-Local-2026

LOG_LEVEL=info
